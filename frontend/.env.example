# Backend API base URL, including the version prefix. Never hard-code it in the app.
VITE_API_BASE_URL=http://localhost:3000/api/v1
# The Google sign-in client ID is NOT set here: the app reads it from the API
# (GET /api/v1/config/public), so frontend and backend always use the same one.

# --- Docker image only (runtime env for nginx, used in the Content-Security-Policy) ---------
# docker build --build-arg VITE_API_BASE_URL=https://api.mustardseed.ng/api/v1 -t mustard-seed-frontend .
# docker run -p 8080:8080 -e API_ORIGIN=... -e SUPABASE_STORAGE_ORIGIN=... mustard-seed-frontend
# API_ORIGIN=https://api.mustardseed.ng
# SUPABASE_STORAGE_ORIGIN=https://<project-ref>.supabase.co
