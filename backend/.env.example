# ---------------------------------------------------------------------------
# Mustard Seed API — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Environment: local | test | staging | production (separate from NODE_ENV).
APP_ENV=local
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Number of reverse-proxy hops to trust for client IPs (0 locally, usually 1 behind a load balancer).
TRUST_PROXY=0

# Exact origins, comma-separated. No wildcards. Production: https://mustardseed.ng only.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting: requests per window per client, and the stricter limit for sign-in,
# order creation, payment initialisation and uploads.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_STRICT_LIMIT=10

# --- Payments (Paystack, or the built-in simulator outside production) ---------------------
PAYSTACK_SIMULATOR_ENABLED=true
PAYSTACK_BASE_URL=http://localhost:3000/simulator/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_URL=http://localhost:3000/api/v1/payments/webhook
SIMULATOR_CONTROL_KEY=

# --- Supabase (database + storage) ---------------------------------------------------------
# Project URL and the service-role / secret key (Project Settings -> API Keys). Backend only:
# never put the key in the frontend, a commit or a log. Use a separate project per environment.
# For a fully local database instead: `pnpm db:start`, then copy API_URL and SECRET_KEY from
# `pnpm db:status`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=site-images
# Per-request database timeout (ms); slow calls fail fast with 503.
SUPABASE_TIMEOUT_MS=5000

# --- Sign-in and sessions --------------------------------------------------------------------
# OAuth client ID from Google Cloud (public). The frontend gets it from /api/v1/config/public.
GOOGLE_CLIENT_ID=
# Google's signing keys. Leave as-is; only the test suite points this elsewhere.
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# Signs session cookies. At least 32 random characters: `openssl rand -base64 48`.
# Different per environment; changing it signs everyone out.
JWT_SECRET=
SESSION_TTL_HOURS_CUSTOMER=168
SESSION_TTL_HOURS_STAFF=12
# First super admin, created by `pnpm seed:super-admin` (their Google account email).
SEED_SUPER_ADMIN_EMAIL=

# --- Variables below are validated by the slices that introduce them -----------------------
MAX_IMAGE_UPLOAD_MB=5

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAIL_FROM="Mustard Seed Restaurant & Bar <orders@mustardseed.ng>"
