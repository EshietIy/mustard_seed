# ---------------------------------------------------------------------------
# Mustard Seed API — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Environment: local | test | staging | production (separate from NODE_ENV).
APP_ENV=local
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Number of reverse-proxy hops to trust for client IPs (0 locally, usually 1 behind a load balancer).
TRUST_PROXY=0

# Exact origins, comma-separated. No wildcards. Production: https://mustardseed.ng only.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting: requests per window per client, and the stricter limit for sign-in,
# order creation, payment initialisation and uploads.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_STRICT_LIMIT=10

# --- Payments (Paystack, or the built-in Paystack Simulator outside production) -------------
# Local/test/staging: the simulator. It needs its OWN key (sk_sim_…, any random value — never a
# real Paystack key), a control key (16+ chars) for its /_control endpoints, and the URL it
# should send webhooks to (this API).
PAYSTACK_SIMULATOR_ENABLED=true
PAYSTACK_BASE_URL=http://localhost:3000/simulator/paystack
PAYSTACK_SECRET_KEY=sk_sim_change_me_local_only
PAYSTACK_WEBHOOK_URL=http://localhost:3000/api/v1/payments/webhook
SIMULATOR_CONTROL_KEY=change-me-local-control-key
# Going live: PAYSTACK_SIMULATOR_ENABLED=false, PAYSTACK_BASE_URL=https://api.paystack.co,
# PAYSTACK_SECRET_KEY=sk_test_… (staging) / sk_live_… (production only), and register the
# webhook URL https://<api host>/api/v1/payments/webhook in the Paystack dashboard.
PAYSTACK_TIMEOUT_MS=10000
# Customer site origin: payment return links go to <FRONTEND_BASE_URL>/orders/<id>.
FRONTEND_BASE_URL=http://localhost:5173
# Unpaid orders expire after this many minutes; the sweep runs every interval (0 = off).
PAYMENT_WINDOW_MINUTES=15
PAYMENT_SWEEP_INTERVAL_MS=60000

# --- Supabase (database + storage) ---------------------------------------------------------
# Project URL and the service-role / secret key (Project Settings -> API Keys). Backend only:
# never put the key in the frontend, a commit or a log. Use a separate project per environment.
# For a fully local database instead: `pnpm db:start`, then copy API_URL and SECRET_KEY from
# `pnpm db:status`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=site-images
# Per-request database timeout (ms); slow calls fail fast with 503.
SUPABASE_TIMEOUT_MS=5000

# --- Sign-in and sessions --------------------------------------------------------------------
# OAuth client ID from Google Cloud (public). The frontend gets it from /api/v1/config/public.
GOOGLE_CLIENT_ID=
# Google's signing keys. Leave as-is; only the test suite points this elsewhere.
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# Signs session cookies. At least 32 random characters: `openssl rand -base64 48`.
# Different per environment; changing it signs everyone out.
JWT_SECRET=
SESSION_TTL_HOURS_CUSTOMER=168
SESSION_TTL_HOURS_STAFF=12
# Android app sign-in (bearer tokens): access token minutes, refresh token days.
APP_ACCESS_TTL_MINUTES=15
APP_REFRESH_TTL_DAYS=30
# Oldest app version still served (x.y.z); older apps are told to update (HTTP 426). Empty = any.
APP_MIN_VERSION=
# First super admin, created by `pnpm seed:super-admin` (their Google account email).
SEED_SUPER_ADMIN_EMAIL=

# --- Variables below are validated by the slices that introduce them -----------------------
MAX_IMAGE_UPLOAD_MB=5

# --- Email (order confirmation) ---------------------------------------------------------------
# log = write emails to the log only (local default, nothing is sent)
# mailgun = really send (required in production; use a sandbox domain or tester allow-list on staging)
MAIL_PROVIDER=log
MAILGUN_API_KEY=
# Your verified sending domain (e.g. mg.mustardseed.ng) or the Mailgun sandbox domain
MAILGUN_DOMAIN=
# US: https://api.mailgun.net   EU: https://api.eu.mailgun.net
MAILGUN_BASE_URL=https://api.mailgun.net
MAIL_FROM="Mustard Seed Restaurant & Bar <orders@mustardseed.ng>"
# Queued emails are sent/retried this often; failed sends retry after 1, 5, 15, 60 min…
EMAIL_DISPATCH_INTERVAL_MS=30000
EMAIL_MAX_ATTEMPTS=5

# --- Estimated arrival / ready time (until the owner confirms the real formula) ---------------
# ETA = payment time + prep + (orders already in the kitchen × per order) + delivery (delivery only)
ETA_PREP_MINUTES=30
ETA_PER_QUEUED_ORDER_MINUTES=5
ETA_DELIVERY_MINUTES=25
